{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "paths": {
      "@salescube/shared": ["./packages/shared/src/index.ts"],
      "@salescube/shared/*": ["./packages/shared/src/*"],
      "@salescube/domain": ["./packages/domain/src/index.ts"],
      "@salescube/domain/*": ["./packages/domain/src/*"],
      "@salescube/db": ["./packages/db/src/index.ts"],
      "@salescube/db/*": ["./packages/db/src/*"],
      "@salescube/ui": ["./packages/ui/src/index.ts"],
      "@salescube/ui/*": ["./packages/ui/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo"]
}
